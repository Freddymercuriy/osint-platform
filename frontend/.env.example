# Frontend muhit o'zgaruvchilari (na'muna). Nusxa: cp .env.example .env.local
# Backend manzili brauzer uchun. Bo'sh qoldirilsa — sahifa ochilgan host'ning 8000-porti (lib/config.ts):
# http://localhost:3000 → http://localhost:8000.
# Reverse proxy ortida (bitta origin, backend /api da) — proxy manzili, masalan Tailscale Serve:
#   NEXT_PUBLIC_API_URL=https://<mashina>.<tailnet>.ts.net
# O'zgartirgach dev serverni qayta ishga tushiring (NEXT_PUBLIC_* ishga tushishda kodga yoziladi).
NEXT_PUBLIC_API_URL=
