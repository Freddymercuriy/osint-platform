# Frontend muhit o'zgaruvchilari (na'muna). Nusxa: cp .env.example .env.local
# Backend manzili brauzer uchun. LAN'dan ochish uchun kompyuterning LAN IP'si (localhost'dan ochilganda ham ishlaydi —
# bu shu mashinaning o'z manzili). Bo'sh qoldirilsa — sahifa ochilgan host'ning 8000-porti (lib/config.ts).
# O'zgartirgach dev serverni qayta ishga tushiring (NEXT_PUBLIC_* ishga tushishda kodga yoziladi).
# Misol (LAN): NEXT_PUBLIC_API_URL=http://192.168.1.50:8000
NEXT_PUBLIC_API_URL=
