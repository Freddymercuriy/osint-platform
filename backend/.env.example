# Backend muhit o'zgaruvchilari (na'muna). Nusxa oling: cp .env.example .env
APP_NAME=OSINT Platform
ENVIRONMENT=development
DEBUG=true

# Database (Docker Compose ishlatganda host = db)
DATABASE_URL=postgresql+asyncpg://osint:osint@db:5432/osint
# Lokal (Docker'siz):
# DATABASE_URL=postgresql+asyncpg://osint:osint@localhost:5432/osint

# JWT — ishlab chiqarishda albatta o'zgartiring! ENVIRONMENT=production bo'lsa standart/qisqa (<32) kalit bilan
# backend ishga tushmaydi. Yangi kalit: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Rollar: shu manzillar admin (vergul bilan). Bo'sh bo'lsa — eng eski faol foydalanuvchi admin bo'ladi.
ADMIN_EMAILS=
# Ochiq ro'yxatdan o'tish. Bo'sh = development'da yoqiq, boshqa muhitda o'chiq.
REGISTRATION_OPEN=

# CORS (frontend manzili)
CORS_ORIGINS=http://localhost:3000

# Telegram user API — https://my.telegram.org → "API development tools"
# Keyin bir marta: docker-compose exec backend python scripts/tg_login.py
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=data/tg_session
# Bo'sh = a'zo bo'lgan barcha kanal/guruhlar. Yoki: kanal1,kanal2,-1001234567890
TG_CHATS=
TG_DIALOG_LIMIT=100
TG_MESSAGES_PER_CHAT=30
# true = faqat O'zbekistonga oid xabarlar (uzbek, .uz, toshkent, узбек ...)
TG_UZ_FILTER=true
# O'zbekistonni bildiruvchi QO'SHIMCHA so'zlar (tashkilot, bank, operator, viloyat). UZ filtr bilan "YOKI" orqali ulanadi —
# shuning uchun bu yerga "leak", "db" kabi umumiy so'zlar QO'YILMAYDI (chet el leaklari ham chiqib ketadi).
TG_EXTRA_KEYWORDS=uzcard,humo,payme,ucell,uztelecom,kapitalbank,toshkent

# Events fon yig'uvchi (v2: har manba o'z intervali bilan — sources jadvali / admin panel; bu yerda faqat yoqish)
EVENTS_POLL_ENABLED=true
# NOTIFY_TELEGRAM=true bo'lsa, ogohlantiriladigan hodisalar Telegram Saved Messages'ga ham yuboriladi.
NOTIFY_TELEGRAM=false
# v2: qaysi kategoriya ogohlantiradi va qancha saqlanadi — categories jadvalida (admin panel). Quyidagi uchtasi faqat
# birinchi migratsiyada (0003) boshlang'ich qiymat sifatida o'qiladi; EVENTS_RETENTION_DAYS — kategoriyasiz eski yozuvlar uchun.
NOTIFY_CATEGORIES=leak,ransomware
EVENTS_RETENTION_DAYS=90
EVENTS_RETENTION_KEEP=ransomware,leak
# Boshlanish sanasi: shundan oldingi hodisalar (BARCHA kategoriyalar) yig'ilmaydi va bazadan o'chiriladi.
# Masalan 2026-11-14 (kun boshi, Toshkent vaqti). Bo'sh = chegara yo'q.
EVENTS_SINCE=
# --- Tashqi threat-intel manbalari kalitlari (v2). Bo'sh bo'lsa manba "auth_missing" holatida o'chiq turadi.
# Kalitlar faqat shu faylda; bazada manba yozuvi o'zgaruvchi NOMINI saqlaydi (sources.api_key_env).
# ransomware.live PRO API (bepul shaxsiy kalit): https://www.ransomware.live → API
RANSOMWARE_LIVE_API_KEY=
# abuse.ch (URLhaus, ThreatFox) Auth-Key: https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# LevelBlue / AlienVault OTX: https://otx.alienvault.com → Settings → OTX Key
OTX_API_KEY=
# NVD API 2.0 (ixtiyoriy — kalitsiz 5 so'rov / 30 s): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Cloudflare Radar (ixtiyoriy) — API token, "Radar: Read" ruxsati: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# --- Tarjima: o'z NLLB servisimiz (facebook/nllb-200, FLORES-200 kodlari), kalit kerak emas.
# Tarjima bo'lmaguncha (yoki servis ishlamasa) qatorlar "pending" qoladi va UI asl matnni ko'rsatadi.
# O'chirish uchun TRANSLATE_ENABLED=false (bo'sh TRANSLATE_API_URL e'tiborsiz — standart manzil ishlatiladi).
TRANSLATE_API_URL=https://translate.deepcore.uz
# Bitta so'rov (≤64 matn) uchun kutish, soniya. Timeout'da qayta urinilmaydi — navbat keyinroq qayta uradi.
TRANSLATE_TIMEOUT_SECONDS=30
TRANSLATE_ENABLED=true
# Oylik belgilar chegarasi; 0 — chegarasiz (hisob statistika uchun baribir yuritiladi)
TRANSLATE_MONTHLY_CHAR_LIMIT=0

# --- Statistika va ogohlantirishlar
# Dashboard vaqt bo'laklari (soat/kun/hafta) shu zonada
APP_TIMEZONE=Asia/Tashkent
# Manba shuncha soat davomida ishlamasa (down/blocked) — adminlarga 🔔 da ogohlantirish
SOURCE_DOWN_ALERT_HOURS=3

# --- Rate limiting (jarayon xotirasida; 429 + Retry-After)
RATE_LIMIT_ENABLED=true
# login: bitta IP dan / bitta email uchun, LOGIN_RATE_WINDOW soniya ichida
LOGIN_RATE_IP=20
LOGIN_RATE_EMAIL=10
LOGIN_RATE_WINDOW=900
# tekshiruvlar (/api/search/*): foydalanuvchi boshiga
SEARCH_RATE=30
SEARCH_RATE_WINDOW=60
# qo'lda yig'ish (/api/events/refresh): foydalanuvchi boshiga (manbani "hozir yig'ish" — 6 baravar)
REFRESH_RATE=5
REFRESH_RATE_WINDOW=600
# Reverse proxy (nginx, Caddy...) ortida: proxy manzillari (IP yoki CIDR, vergul bilan). Faqat shulardan kelgan so'rovda
# X-Forwarded-For o'qiladi — aks holda hamma foydalanuvchi proxy IP'si bilan bitta login limitiga tushadi.
# Bo'sh = to'g'ridan-to'g'ri ulanish, sarlavha e'tiborsiz. Misol: TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=

# SQL so'rovlarni logga chiqarish (debug)
DB_ECHO=false
