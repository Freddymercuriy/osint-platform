# Backend muhit o'zgaruvchilari (na'muna). Nusxa oling: cp .env.example .env
APP_NAME=OSINT Platform
ENVIRONMENT=development
DEBUG=true

# Database (Docker Compose ishlatganda host = db)
DATABASE_URL=postgresql+asyncpg://osint:osint@db:5432/osint
# Lokal (Docker'siz):
# DATABASE_URL=postgresql+asyncpg://osint:osint@localhost:5432/osint

# JWT — ishlab chiqarishda albatta o'zgartiring! ENVIRONMENT=production bo'lsa standart/qisqa (<32) kalit bilan
# backend ishga tushmaydi. Yangi kalit: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Rollar: shu manzillar admin (vergul bilan). Bo'sh bo'lsa — eng eski faol foydalanuvchi admin bo'ladi.
ADMIN_EMAILS=
# Ochiq ro'yxatdan o'tish. Bo'sh = development'da yoqiq, boshqa muhitda o'chiq.
REGISTRATION_OPEN=

# CORS (frontend manzili)
CORS_ORIGINS=http://localhost:3000

# Telegram user API — https://my.telegram.org → "API development tools"
# Keyin bir marta: docker-compose exec backend python scripts/tg_login.py
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=data/tg_session
# Bo'sh = a'zo bo'lgan barcha kanal/guruhlar. Yoki: kanal1,kanal2,-1001234567890
TG_CHATS=
TG_DIALOG_LIMIT=100
TG_MESSAGES_PER_CHAT=30
# true = faqat O'zbekistonga oid xabarlar (uzbek, .uz, toshkent, узбек ...)
TG_UZ_FILTER=true
# O'zbekistonni bildiruvchi QO'SHIMCHA so'zlar (tashkilot, bank, operator, viloyat). UZ filtr bilan "YOKI" orqali ulanadi —
# shuning uchun bu yerga "leak", "db" kabi umumiy so'zlar QO'YILMAYDI (chet el leaklari ham chiqib ketadi).
TG_EXTRA_KEYWORDS=uzcard,humo,payme,ucell,uztelecom,kapitalbank,toshkent

# Events fon yig'uvchi
EVENTS_POLL_ENABLED=true
EVENTS_POLL_SECONDS=300
# Saytdagi 🔔 ogohlantirishlar shu kategoriyalar uchun. NOTIFY_TELEGRAM=true bo'lsa, Saved Messages'ga ham yuboriladi
NOTIFY_TELEGRAM=false
NOTIFY_CATEGORIES=leak,ransomware
# Retention: shu kundan eski hodisalar har yig'ishda bazadan o'chiriladi (0 = o'chirilmaydi).
# EVENTS_RETENTION_KEEP dagi kategoriyalar muddatidan qat'i nazar saqlanadi.
EVENTS_RETENTION_DAYS=90
EVENTS_RETENTION_KEEP=ransomware,leak
# Boshlanish sanasi: shundan oldingi hodisalar (BARCHA kategoriyalar) yig'ilmaydi va bazadan o'chiriladi.
# Masalan 2026-11-14 (kun boshi, Toshkent vaqti). Bo'sh = chegara yo'q.
EVENTS_SINCE=
# --- Tashqi threat-intel manbalari kalitlari (v2). Bo'sh bo'lsa manba "auth_missing" holatida o'chiq turadi.
# Kalitlar faqat shu faylda; bazada manba yozuvi o'zgaruvchi NOMINI saqlaydi (sources.api_key_env).
# ransomware.live PRO API (bepul shaxsiy kalit): https://www.ransomware.live → API
RANSOMWARE_LIVE_API_KEY=
# abuse.ch (URLhaus, ThreatFox) Auth-Key: https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# LevelBlue / AlienVault OTX: https://otx.alienvault.com → Settings → OTX Key
OTX_API_KEY=
# NVD API 2.0 (ixtiyoriy — kalitsiz 5 so'rov / 30 s): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Cloudflare Radar (ixtiyoriy) — API token, "Radar: Read" ruxsati: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# SQL so'rovlarni logga chiqarish (debug)
DB_ECHO=false
