# Backend muhit o'zgaruvchilari (na'muna). Nusxa oling: cp .env.example .env
APP_NAME=OSINT Platform
ENVIRONMENT=development
DEBUG=true

# Database (Docker Compose ishlatganda host = db)
DATABASE_URL=postgresql+asyncpg://osint:osint@db:5432/osint
# Lokal (Docker'siz):
# DATABASE_URL=postgresql+asyncpg://osint:osint@localhost:5432/osint

# JWT — ishlab chiqarishda albatta o'zgartiring!
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS (frontend manzili)
CORS_ORIGINS=http://localhost:3000

# Telegram user API — https://my.telegram.org → "API development tools"
# Keyin bir marta: docker-compose exec backend python scripts/tg_login.py
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=data/tg_session
# Bo'sh = a'zo bo'lgan barcha kanal/guruhlar. Yoki: kanal1,kanal2,-1001234567890
TG_CHATS=
TG_DIALOG_LIMIT=100
TG_MESSAGES_PER_CHAT=30
# true = faqat O'zbekistonga oid xabarlar (uzbek, .uz, toshkent, узбек ...)
TG_UZ_FILTER=true
# O'zbekistonni bildiruvchi QO'SHIMCHA so'zlar (tashkilot, bank, operator, viloyat). UZ filtr bilan "YOKI" orqali ulanadi —
# shuning uchun bu yerga "leak", "db" kabi umumiy so'zlar QO'YILMAYDI (chet el leaklari ham chiqib ketadi).
TG_EXTRA_KEYWORDS=uzcard,humo,payme,ucell,uztelecom,kapitalbank,toshkent
